{
   "type":"object",
   "$schema":"http://json-schema.org/draft-04/schema",
   "title":"VCMI bonus type format",
   "description":"Definition of battle effect types",
   "required":[
      
   ],
   "additionalProperties":false,
   "allOf":[
      {
         "if":{
            "properties":{
               "action":{
                  "enum":[
                     "bonus"
                  ]
               }
            }
         },
         "then":{
            "additionalProperties":false,
            "required":[
               "action",
               "trigger",
               "bonus"
            ],
            "properties":{
               "action":{
                  "enum":[
                     "bonus"
                  ]
               },
               "trigger":{
                  "$ref":"trigger.json"
               },
               "bonus":{
                  "$ref":"bonusInstance.json"
               }
            }
         }
      },
      {
         "if":{
            "properties":{
               "action":{
                  "enum":[
                     "spell"
                  ]
               }
            }
         },
         "then":{
            "additionalProperties":false,
            "required":[
               "action",
               "trigger",
               "spell"
            ],
            "properties":{
               "action":{
                  "enum":[
                     "spell"
                  ]
               },
               "trigger":{
                  "$ref":"trigger.json"
               },
               "targetEnemy":{
                  "type":"boolean"
               },
               "mastery":{
                  "type":"number"
               },
               "spell":{
                  "type":"string"
               }
            }
         }
      },
      {
         "if":{
            "properties":{
               "action":{
                  "enum":[
                     "changeDuration"
                  ]
               }
            }
         },
         "then":{
            "additionalProperties":false,
            "required":[
               "action",
               "trigger",
               "value"
            ],
            "properties":{
               "action":{
                  "enum":[
                     "changeDuration"
                  ]
               },
               "trigger":{
                  "$ref":"trigger.json"
               },
               "value":{
                  "type":"number"
               }
            }
         }
      },
      {
         "if":{
            "properties":{
               "action":{
                  "enum":[
                     "terminate"
                  ]
               }
            }
         },
         "then":{
            "additionalProperties":false,
            "required":[
               "action",
               "trigger"
            ],
            "properties":{
               "action":{
                  "enum":[
                     "terminate"
                  ]
               },
               "trigger":{
                  "$ref":"trigger.json"
               }
            }
         }
      }
   ],
   "properties":{
      "action":{
         "type" : "string", 
         "enum" : [ "bonus", "spell", "changeDuration", "terminate" ]
      },
      "trigger":{
         "$ref":"trigger.json"
      },
      "targetEnemy":{
         "type":"boolean"
      },
      "bonus":{
         "$ref":"bonusInstance.json"
      },
      "mastery":{
         "type":"number"
      },
      "spell":{
         "type":"string"
      },
      "value":{
         "type":"number"
      }
   }
}
