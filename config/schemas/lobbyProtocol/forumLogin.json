{
	"type" : "object",
	"$schema" : "http://json-schema.org/draft-06/schema",
	"title" : "Lobby protocol: forumLogin",
	"description" : "Sent by client when player attempts to authenticate using forum.vcmi.eu credentials",
	"required" : [ "type", "username", "password", "language", "version" ],
	"additionalProperties" : false,

	"properties" : {
		"type" :
		{
			"type" : "string",
			"const" : "forumLogin"
		},
		"username" :
		{
			"type" : "string",
			"description" : "Forum username"
		},
		"password" :
		{
			"type" : "string",
			"description" : "Forum password"
		},
		"language" :
		{
			"type" : "string",
			"description" : "Language of client, see lib/Languages.h for full list"
		},
		"version" :
		{
			"type" : "string",
			"description" : "Version of client, e.g. 1.5.0"
		}
	}
}
