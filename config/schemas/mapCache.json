{
	"type" : "array",
	"$schema" : "http://json-schema.org/draft-04/schema",
	"title" : "VCMI map cache",
	"description" : "Cached map metadata for a mod, to avoid reading individual map files",
	"items" : {
		"type" : "object",
		"required" : ["fileURI", "name", "width", "height"],
		"additionalProperties" : false,
		"properties" : {
			"version" : {
				"type" : "integer",
				"description" : "Map format version (14=ROE, 21=AB, 28=SOD, 29=CHR, 32=HOTA, 51=WOG, 100=VCMI)"
			},
			"fileURI" : {
				"type" : "string",
				"description" : "Relative path of the map file within the mod"
			},
			"name" : {
				"type" : "string",
				"description" : "Map name (original string, untranslated)"
			},
			"description" : {
				"type" : "string",
				"description" : "Map description (original string, untranslated)"
			},
			"author" : {
				"type" : "string",
				"description" : "Map author"
			},
			"authorContact" : {
				"type" : "string",
				"description" : "Author contact information"
			},
			"mapVersion" : {
				"type" : "string",
				"description" : "Map version string"
			},
			"creationDateTime" : {
				"type" : "integer",
				"description" : "Map creation timestamp"
			},
			"width" : {
				"type" : "integer",
				"minimum" : 1,
				"description" : "Map width in tiles"
			},
			"height" : {
				"type" : "integer",
				"minimum" : 1,
				"description" : "Map height in tiles"
			},
			"difficulty" : {
				"type" : "integer",
				"minimum" : 0,
				"maximum" : 4,
				"description" : "Map difficulty (0=easy, 1=normal, 2=hard, 3=expert, 4=impossible)"
			},
			"levelLimit" : {
				"type" : "integer",
				"minimum" : 0,
				"description" : "Hero level limit (0 = no limit)"
			},
			"players" : {
				"type" : "array",
				"items" : {
					"type" : "boolean"
				},
				"description" : "Boolean array of 8 player slots - true if the slot can be played by human or AI"
			},
			"howManyTeams" : {
				"type" : "integer",
				"description" : "Number of teams on the map"
			},
			"requiredMods" : {
				"type" : "array",
				"description" : "List of mods required to play this map",
				"items" : {
					"type" : "object",
					"required" : ["name"],
					"additionalProperties" : false,
					"properties" : {
						"name" : {
							"type" : "string"
						},
						"version" : {
							"type" : "string"
						}
					}
				}
			}
		}
	}
}
