// Descriptions are empty here on purpose: the text every one of these scripts shows to the
// player lives in the translation files as core.script.<name>.description, so that it is not
// spelled out twice. A mod is expected to declare the text right here instead.
{
	"transmutation" : {
		"implements" : "combatEvent",
		"script" : "combat/transmutation",
		"patches" : [ ],
		"priority" : 300,
		"schema" : {
			"properties" : {
				"creature" : { "type" : "string", "entity" : "creature", "description" : "creature the victim turns into. Defaults to the creature of the attacker" },
				"transmuteBy" : { "type" : "string", "enum" : ["health", "count"], "description" : "'health' keeps the total health of the victim, 'count' keeps its creature count" }
			},
			"additionalProperties" : false
		},
		"description" : ""
	},
	"summonGuardians" : {
		"implements" : "combatEvent",
		"script" : "combat/summonGuardians",
		"patches" : [ ],
		"priority" : 0,
		"schema" : {
			"required" : ["creature"],
			"properties" : {
				"creature" : { "type" : "string", "entity" : "creature", "description" : "creature to summon as guardian" }
			},
			"additionalProperties" : false
		},
		"description" : ""
	},
	"enchanted" : {
		"implements" : "combatEvent",
		"script" : "combat/enchanted",
		"patches" : [ ],
		"priority" : 0,
		"schema" : {
			"required" : ["spell"],
			"properties" : {
				"spell" : { "type" : "string", "entity" : "spell", "description" : "spell whose effects are applied" },
				"level" : { "type" : "number", "description" : "mastery level the effects are applied at" },
				"massive" : { "type" : "boolean", "description" : "true to affect every allied unit instead of only the bearer" },
				"duration" : { "type" : "number", "description" : "how many turns the effects last. Defaults to 50, long enough to accumulate rather than expire between rounds" }
			},
			"additionalProperties" : false
		},
		"description" : ""
	},
	"lifeDrain" : {
		"implements" : "combatEvent",
		"script" : "combat/lifeDrain",
		"patches" : [ ],
		"priority" : 0,
		"schema" : {
			"properties" : {},
			"additionalProperties" : false
		},
		"description" : ""
	},
	"arrowTowerDamage" : {
		"implements" : "combatEvent",
		"script" : "combat/arrowTowerDamage",
		"patches" : [ ],
		"priority" : 0,
		"schema" : {
			"properties" : {
				"keepBase" : { "type" : "number", "description" : "damage of the keep in a town with nothing built" },
				"towerBase" : { "type" : "number", "description" : "damage of the two lesser towers in a town with nothing built" },
				"perBuilding" : { "type" : "number", "description" : "damage each building adds to the keep; the lesser towers get half of it" }
			},
			"additionalProperties" : false
		},
		"description" : ""
	},
	"damageCalculator" : {
		"implements" : "damageCalculator",
		"script" : "damage/damageCalculator",
		"patches" : [
			// special cases for H3 scenarios
			"damage/siegeWeapon",
			"damage/magicElemental",
			"damage/psychicElemental",
			// mod-only logic, to be removed after migration
			"damage/vulnerableFromBack",
			"damage/hatesTrait",
			"damage/revenge",
			"damage/enemyAttackReduction",
			"damage/damageReceivedCap"
		],
		"schema" : {
