  "secondaryRoadType": "dirtRoad",
  "treasureValueLimit" : 20000, //generate pandora with gold for treasure above this limit
  "prisons" :
  {
    "experience" : [0, 5000, 15000, 90000, 500000],
    "value" : [2500, 5000, 10000, 20000, 30000],
