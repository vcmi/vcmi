  "quests" : 
  {
    "seerHutValue" : 500,
    "value" : [2000, 5333, 8666, 12000],
    "rewardValue" : [5000, 10000, 15000, 20000]
  },
  "singleThread" : false,

  // Experimental zone-placement improvements (see CZonePlacer). Toggle to compare against baseline.
  "zonePlacement" :
  {
    "hexGrid" : true,            // seed the initial layout on a hex (6-neighbour) grid instead of a square (4-orthogonal) one
    "hubFirst" : true,           // place zones highest-degree first, seeding each level's hub at the grid centre
    "saPolish" : true,           // simulated-annealing pass that swaps grid cells to improve connected-zone adjacency
    "crossAlignWeight" : 6.0,    // during saPolish, reward for cross-level partners sharing a normalized cell (0 = ignore; aligns subterranean-gate columns discretely)

    // Capacity-constrained tessellation: iterate a per-zone Voronoi weight so each zone's claimed area
    // converges to its target (proportional to size, a linear area weight), instead of whatever the raw Penrose partition gives.
    "capacityBalance" : true,
    "capacityIterations" : 100,  // number of weight-balancing passes
    "capacityGain" : 0.2,        // weight step per pass (fraction-of-area error -> normalized dist^2)

    // When two zones connected across levels do not share a column, place the subterranean gates on the
    // nearest suitable tiles in each zone instead of failing to a monolith. Gates pair in-game by nearest
    // 2D distance, so a pair is only placed apart when it stays each other's nearest gate. This is the
    // maximum allowed 2D distance (in tiles) between the two gates; 0 disables off-column placement (gates
    // must share a column, as before).
    "maxGateDistance" : 16,

    // Reorient the finished layout by a random rotation (0/90/180/270) plus optional horizontal and
    // vertical flips (16 combinations). These are isometries on a square map, so the layout quality and
    // connection score are unchanged - only the facing differs. Without this a fixed template graph
    // (placed deterministically by hubFirst) always produces the same, unrotated, unflipped map.
    "randomOrientation" : true,

    // Relax the layout this many times and keep the one with the lowest weighted connection score.
    // Score = direct * scoreDirect + subterranean gates * scoreSubterraneanGate + monoliths * scoreMonolith (lower is better).
    "attempts" : 8,
    "scoreDirect" : 1,
    "scoreSubterraneanGate" : 2,
    "scoreMonolith" : 10
  }
}
